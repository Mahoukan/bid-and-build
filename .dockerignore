# Explicit build inputs only. Secrets, local binaries, data and Git stay outside.
**
!Dockerfile
!.dockerignore
!.npmrc
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.server.json
!vite.config.ts
!client/
!client/**
!server/
!server/**
!shared/
!shared/**
!engine/
!engine/**
!samples/
!samples/dragon-game.json
!scripts/
!scripts/start.mjs
# Also exclude private/generated files nested inside an allowed source folder.
**/.env
**/.env.*
**/node_modules
**/.git
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.log
**/.DS_Store
**/Thumbs.db
