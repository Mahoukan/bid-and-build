NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
APP_ORIGIN=http://localhost:5173
# Leave blank here. npm run setup generates a private random value in .env.
# Existing .env files are never replaced. Production needs its own stable secret.
SESSION_SECRET=
# Empty trusts no forwarded IPs. For Coolify, use only its actual proxy IP/CIDR.
# Never use true, a hop count or a public all-addresses network.
TRUST_PROXY=
