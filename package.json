{
  "name": "bid-and-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "npm run setup",
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --import tsx server/main.ts",
    "dev:client": "vite --config vite.config.ts",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "db:migrate": "node dist/server/cli/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
